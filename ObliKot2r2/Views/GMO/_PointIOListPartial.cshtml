@model IEnumerable<PointIO>

<table class="table table-sm table-hover">
    <thead class="table-light">
        <tr>
            <th>Назва</th>
            <th>Тип</th>
            <th>EIC-код</th>
            <th>Дата початку</th>
            <th>Дата заверш.</th>
            <th class="text-end">Дії</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.NamePointIO</td>
                    <td>@item.PointIOType?.NameTypePointIO</td>
                    <td>@item.EIC</td>
                    <td>@item.DateBegin.ToString("dd.MM.yyyy")</td>
                    <td>@(item.DateEnd?.ToString("dd.MM.yyyy") ?? "-")</td>
                    <td class="text-end">
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-outline-primary edit-point"
                                    data-id="@item.IdPointIOSAP">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn btn-outline-danger delete-point"
                                    data-id="@item.IdPointIOSAP">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center text-muted py-4">
                    <i class="bi bi-info-circle"></i> Точки входу/виходу відсутні
                </td>
            </tr>
        }
    </tbody>
</table>