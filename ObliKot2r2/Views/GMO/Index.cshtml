@model IEnumerable<ObliKot2r2.Models.GasMeasuringObject>
@{
    ViewData["Title"] = "Газовимірювальні об'єкти";
}
<style>
    .card {
        border-radius: 0.5rem;
        border: none;
    }

    .table {
        margin-bottom: 0;
    }

        .table th {
            font-weight: 500;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.5px;
        }

    .table-hover tbody tr:hover {
        background-color: rgba(13, 110, 253, 0.05);
    }

    .clickable-row:hover {
        background-color: rgba(13, 110, 253, 0.08) !important;
    }

    .action-cell {
        pointer-events: auto !important;
    }

    /* Стили для вкладок в модальном окне */
    #gmoTabs .nav-link {
        color: #0d6efd;
        background-color: rgba(255, 255, 255, 0.1);
        border-color: #dee2e6 #dee2e6 #fff;
        margin-right: 5px;
    }

        #gmoTabs .nav-link.active {
            color: #fff !important;
            background-color: #0d6efd !important;
            border-color: #dee2e6 #dee2e6 #0d6efd !important;
            font-weight: 500;
        }

        #gmoTabs .nav-link:hover:not(.active) {
            color: #0a58ca;
            background-color: rgba(255, 255, 255, 0.2);
        }

    #pointIOTableBody tr {
        vertical-align: middle;
    }

    #pointIOTableBody td, #pointIOTableBody th {
        padding: 0.5rem;
    }

    #pointIOTableBody .btn-sm {
        padding: 0.25rem 0.5rem;
        font-size: 0.75rem;
    }
</style>
<style>
    /* Анимации для плавности */
    .card {
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 12px rgba(0,0,0,0.1) !important;
        }

    /* Кастомный скролл для таблицы */
    .table-responsive {
        max-height: 65vh;
        overflow-y: auto;
    }

        .table-responsive::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        .table-responsive::-webkit-scrollbar-thumb {
            background: #c1c1c1;
            border-radius: 10px;
        }
</style>

<div class="container-fluid">
    <div class="card shadow-sm">
        <!-- Заголовок карточки -->
        <div class="card-header bg-primary text-white">
            <div class="d-flex justify-content-between align-items-center">
                <h4 class="mb-0">@ViewData["Title"]</h4>
                <a asp-action="Create" class="btn btn-light">
                    <i class="bi bi-plus-circle"></i> Додати
                </a>
            </div>
        </div>

        <!-- Тело таблицы -->
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Назва</th>
                            <th>Майданчик</th>
                            <th>Підрозділ</th>
                            <th>Філія</th>
                            <th>SAP ID</th>
                            <th class="text-end">Дії</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="clickable-row" data-gmo-id="@item.IdGMO">
                                <td>@item.NameGMO</td>
                                <td>@item.Area?.NameArea</td>
                                <td>@item.Area?.Subdivision?.NameSubdivision</td>
                                <td>@item.Area?.Subdivision?.Philia?.NamePhilia</td>
                                <td>@item.IdGmoSAP</td>
                                <td class="text-end action-cell">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@item.IdGMO" class="btn btn-outline-primary">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        &nbsp;
                                        <form asp-action="Delete" asp-route-id="@item.IdGMO" method="post">
                                            <button type="submit" class="btn btn-outline-danger"
                                                    onclick="return confirm('Видалити об\'єкт?')">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                        &nbsp;
                                        <button class="btn btn-outline-info"
                                                onclick="loadGMODetails(@item.IdGMO, '@item.NameGMO')">
                                            <i class="bi bi-card-text"></i> Деталі
                                        </button>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


<!-- Modal -->
<div class="modal fade" id="gmoDetailsModal" tabindex="-1" aria-labelledby="gmoDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="gmoDetailsModalLabel">Повні дані об'єкту <span id="gmoNameHeader"></span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Вкладки -->
                <ul class="nav nav-tabs mb-4" id="gmoTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="main-tab" data-bs-toggle="tab" data-bs-target="#main" type="button">Основні дані</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="points-tab" data-bs-toggle="tab" data-bs-target="#points" type="button">Точки входу/виходу</button>
                    </li>

                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="pipes-tab" data-bs-toggle="tab" data-bs-target="#pipes" href="#pipesTab" type="button">
                            Вимірювальні трубопроводи
                        </button>
                    </li>

                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="contracts-tab" data-bs-toggle="tab" data-bs-target="#contracts" type="button">Договори</button>
                    </li>
                </ul>

                <!-- Содержимое вкладок -->
                <div class="tab-content" id="gmoTabsContent">
                    <!-- Вкладка 1: Основные данные -->
                    <div class="tab-pane fade show active" id="main" role="tabpanel">
                        <form id="gmoMainForm">
                            <input type="hidden" id="gmoId" />
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">Назва ГМО*</label>
                                    <input type="text" class="form-control" id="nameGMO" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Майданчик*</label>
                                    <select class="form-select" id="areaId" required>
                                        <option value="">Оберіть майданчик...</option>
                                        @foreach (var area in ViewBag.Areas)
                                        {
                                            <option value="@area.IdArea">@area.FullName</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <!-- Другие поля ГМО -->
                        </form>
                    </div>


                    <!-- Вкладка 2: Точки входа/выхода -->

                    <div class="tab-pane fade" id="points" role="tabpanel">
                        <div class="d-flex justify-content-between mb-3">
                            <h5>Точки входу/виходу</h5>
                            <button class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#addPointModal">
                                <i class="bi bi-plus-circle"></i> Додати точку
                            </button>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-sm table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Назва</th>
                                        <th>Тип</th>
                                        <th>EIC-код</th>
                                        <th>Дата початку</th>
                                        <th>Дата заверш.</th>
                                        <th class="text-end">Дії</th>
                                    </tr>
                                </thead>
                                <tbody id="pointIOTableBody">
                                    <!-- Данные будут загружаться через AJAX -->
                                </tbody>
                            </table>

                        </div>
                    </div>


                    <div class="tab-pane fade" id="pipes" role="tabpanel">
                        <div class="d-flex justify-content-between mb-3">
                            <h5>Вимірювальні трубопроводи</h5>
                            <button class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#addPipeModal">
                                <i class="bi bi-plus-circle"></i> Додати трубопровід
                            </button>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-sm table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Назва</th>
                                        <th>SAP ID</th>
                                        <th>Зовнішній ID</th>
                                        <th class="text-end">Дії</th>
                                    </tr>
                                </thead>
                                <tbody id="pipesTableBody">
                                    <!-- Данные будут загружены через AJAX -->
                                </tbody>
                            </table>
                        </div>
                    </div>



                    <!-- Вкладка 3: Договоры -->
                    <div class="tab-pane fade" id="contracts" role="tabpanel">
                        <!-- Аналогичная структура для договоров -->
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрити</button>
                <button type="button" class="btn btn-primary" onclick="saveAllGMODetails()">Зберегти все</button>
            </div>
        </div>
    </div>
</div>


<!-- Модальное окно для добавления/редактирования точки -->
<div class="modal fade" id="addPointModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="pointModalTitle">Додати точку</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="pointIOForm">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" id="pointId" />
                    <input type="hidden" id="pointGmoId" />

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Назва точки*</label>
                            <input type="text" class="form-control" id="pointName" required maxlength="200">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Тип точки*</label>
                            <select class="form-select" id="pointType" required>
                                <option value="">Оберіть тип...</option>
                                <!--    Типы будут загружены через AJAX -->
                            </select>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label">EIC-код</label>
                            <input type="text" class="form-control" id="pointEIC" maxlength="16">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Дата початку*</label>
                            <input type="date" class="form-control" id="pointDateBegin" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Дата завершення</label>
                            <input type="date" class="form-control" id="pointDateEnd">
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">SAP ID</label>
                            <input type="text" class="form-control" id="pointSapId" maxlength="20">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Зовнішній ID</label>
                            <input type="text" class="form-control" id="pointAnotherId" maxlength="20">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Скасувати</button>
                    <button type="submit" class="btn btn-primary">Зберегти</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Модальное окно для добавления/редактирования трубы -->
<div class="modal fade" id="addPipeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Додати трубопровід</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="pipeForm">
                    <input type="hidden" id="pipeId" value="0">
                    <input type="hidden" id="gmoId"> <!-- Передаём IdGMO из модели -->
                    <div class="mb-3">
                        <label for="pipeName" class="form-label">Назва *</label>
                        <input type="text" class="form-control" id="pipeName" required>
                    </div>
                    <div class="mb-3">
                        <label for="pipeSapId" class="form-label">SAP ID</label>
                        <input type="text" class="form-control" id="pipeSapId">
                    </div>
                    <div class="mb-3">
                        <label for="pipeExternalId" class="form-label">Зовнішній ID</label>
                        <input type="text" class="form-control" id="pipeExternalId">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Скасувати</button>
                <button type="button" class="btn btn-primary" id="savePipeBtn">Зберегти</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
         // В начале
         const getAntiForgeryToken = () => $('input[name="__RequestVerificationToken"]').val();
         let currentGmoId = 0;
         let currentGmoName = '';
         let pointIOTypes = [];


         $(document).ready(function () {
             // Переключение вкладок
             $('#gmoTabs button').on('click', function () {
                 loadActiveTabData();
             });

             $.get('/GMO/GetPointIOTypes')
         .done(function(data) {
             pointIOTypes = data;
         })
         .fail(function(xhr) {
             console.error('Ошибка загрузки типов точек:', xhr.responseText);
         });

        // Блокировка кнопки при отправке формы и разблокировка после завершения
         $(document).on('submit', 'form', function () {
             const $submitButton = $(this).find('button[type="submit"]');
             $submitButton.prop('disabled', true);

             // Для AJAX-форм добавим автоматическую разблокировку
             if ($(this).attr('data-ajax') === 'true' || $(this).hasClass('ajax-form')) {
                 $(this).one('ajax:complete', function() {
                     $submitButton.prop('disabled', false);
                 });
             }
         });


        

         });


              


         // Загрузка данных ГМО
         function loadGMODetails(gmoId, gmoName) {
             currentGmoId = gmoId;
             currentGmoName = gmoName;

              document.getElementById('gmoId').value = gmoId;

             $('#gmoNameHeader').text(gmoName);
             $('#gmoId').val(gmoId);

             $('.tab-pane').html('<div class="text-center p-4"><div class="spinner-border"></div></div>');

             const modal = new bootstrap.Modal('#gmoDetailsModal');
             modal.show();

             loadActiveTabData();
         }

         // Загрузка данных для активной вкладки
         function loadActiveTabData() {
             const activeTabId = $('#gmoTabs .nav-link.active').attr('id');

                    switch (activeTabId) {
                    case 'main-tab':
                        $.get(`/GMO/GetMainData?id=${currentGmoId}`)
                        .done(function (data) {
                        $('#main').html(data);
                        })
                        .fail(function (xhr) {
                        $('#main').html('<div class="alert alert-danger">Помилка завантаження даних</div>');
                        console.error('Помилка:', xhr.statusText);
                        });
                    break;

                    case 'points-tab':
                      loadPointIOs();
                    break;

                    case 'pipes-tab':
                        loadPipes(currentGmoId);
                    break;
                    }
         }

         function formatDate(dateString) {
             if (!dateString) return '-';
             try {
                 const date = new Date(dateString);
                 return date.toLocaleDateString('uk-UA', {
                     year: 'numeric',
                     month: '2-digit',
                     day: '2-digit'
                 });
             } catch {
                 return dateString;
             }
         }

         // Сохранение данных ГМО
         function saveAllGMODetails() {
             const formData = {
                 idGMO: $('#gmoId').val(),
                 nameGMO: $('#nameGMO').val(),
                 idArea: $('#areaId').val()
             };

             $.ajax({
                 url: '/GMO/UpdateDetails',
                 method: 'POST',
                 contentType: 'application/json',
                 data: JSON.stringify(formData),
                 success: function () {
                     alert('Дані успішно збережено!');
                     $('#gmoDetailsModal').modal('hide');
                     location.reload();
                 },
                 error: function (xhr) {
                     alert('Помилка: ' + xhr.responseText);
                 }
             });
         }

                  // Загрузка точек входа/выхода
                 function loadPointIOs() {
             $('#points').html('<div class="text-center p-4"><div class="spinner-border"></div></div>');

             $.get(`/GMO/GetPointIOs?id=${currentGmoId}`)
                 .done(function(data) {
                     $('#points').html(`
                         <div class="d-flex justify-content-between mb-3">
                             <h5>Точки входу/виходу</h5>
                             <button class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#addPointModal">
                                 <i class="bi bi-plus-circle"></i> Додати точку
                             </button>
                         </div>
                         ${data}
                     `);
                     initPointIOEvents();
                 })
                 .fail(function(xhr) {
                     $('#points').html(`
                         <div class="alert alert-danger">
                             Помилка завантаження точок: ${xhr.responseText || 'Невідома помилка'}
                         </div>
                         <button class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#addPointModal">
                             <i class="bi bi-plus-circle"></i> Додати точку
                         </button>
                     `);
                     console.error('Помилка:', xhr.statusText);
                 });
         }

         // Инициализация событий для точек
         function initPointIOEvents() {
             // Добавление новой точки
              $('[data-bs-target="#addPointModal"]').off('click').on('click', function () {
             $('#pointModalTitle').text('Додати точку');
             $('#pointIOForm')[0].reset();
             $('#pointGmoId').val(currentGmoId);
             $('#pointId').val('');

             const $typeSelect = $('#pointType');
             $typeSelect.prop('disabled', true);
             $typeSelect.html('<option value="">Завантаження типів...</option>');

             // Загружаем типы точек при открытии модального окна
             $.get('/GMO/GetPointIOTypes')
                 .done(function (types) {
                     $typeSelect.empty().append('<option value="">Оберіть тип...</option>');
                     types.forEach(function (type) {
                         $typeSelect.append($('<option>', {
                             value: type.id,
                             text: type.name
                         }));
                     });

                     // Только после добавления опций – сбрасываем выбранный пункт
                     $typeSelect.val('');
                     $typeSelect.prop('disabled', false);
                 })
                 .fail(function (xhr) {
                     $typeSelect.html('<option value="">Помилка завантаження типів</option>');
                     console.error('Помилка завантаження типів:', xhr.responseText);
                 });
         });



             // Редактирование точки
             $('.edit-point').off('click').on('click', function() {
                 const pointId = $(this).data('id');
                 $('#pointModalTitle').text('Редагувати точку');

                 $.get(`/GMO/GetPointIO?id=${pointId}`)
                     .done(function(data) {
                         $('#addPointModal .modal-body').html(data);
                         $('#addPointModal').modal('show');
                     });
             });

             // Удаление точки
             $('.delete-point').off('click').on('click', function() {
                 if (confirm('Видалити точку?')) {
                     const pointId = $(this).data('id');

                     $.post({
                         url: '/GMO/DeletePointIO',
                         data: { id: pointId, __RequestVerificationToken: getAntiForgeryToken() },
                         success: function() {
                             loadPointIOs();
                         },
                         error: function(xhr) {
                             alert('Помилка: ' + xhr.responseText);
                         }
                     });
                 }
             });
         }

         // Сохранение точки
         $('#pointIOForm').submit(function(e) {
             e.preventDefault();
                function parseDateInput(selector) {
             const val = $(selector).val();
             if (!val) return null;

             const parts = val.split('.');
             if (parts.length === 3) {
                 return `${parts[2]}-${parts[1]}-${parts[0]}`; // dd.mm.yyyy → yyyy-mm-dd
             }
             return val; // возможно уже ISO
         }
             const formData = {
                 IdPointIOSAP: $('#pointId').val(),
                 IdGMO: $('#pointGmoId').val(),
                 NamePointIO: $('#pointName').val(),
                 IdTypePointIO: $('#pointType').val(),
                 EIC: $('#pointEIC').val(),
                   DateBegin: parseDateInput('#pointDateBegin'),
                   DateEnd: parseDateInput('#pointDateEnd'),
                 IdAnother: $('#pointAnotherId').val(),
                 __RequestVerificationToken: getAntiForgeryToken()
             };

             $.ajax({
                 url: '/GMO/SavePointIO',
                 method: 'POST',
        //          data: $('#pointIOForm').serialize(),
                contentType: 'application/json',
         //             headers: {
         //     'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
         // },
               data: JSON.stringify(formData),
                 success: function() {
                     $('#addPointModal').modal('hide');
                     loadPointIOs();
                 },
            error: function(xhr) {
            const errorMsg = xhr.responseJSON?.error || 'Невідома помилка';
            $('#pointIOError').text(errorMsg).show();

            setTimeout(() => {
                $('#pointIOError').fadeOut();
            }, 5000);
        },
                 complete: function() {
            $submitButton.prop('disabled', false); // Разблокировка кнопки в любом случае
        }
             });
         });


         /* ==================  Вимірювальні трубопроводи ================ */

        function loadPipes(gmoId) {
            $('#pipes').html('<div class="text-center p-4"><div class="spinner-border"></div></div>');

            $.get(`/MeasuringPipes/Index`, { gmoId: gmoId })
                .done(function (data) {
                    $('#pipes').html(`
                        <div class="d-flex justify-content-between mb-3">
                            <h5>Вимірювальні трубопроводи</h5>
                            <button class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#addPipeModal">
                                <i class="bi bi-plus-circle"></i> Додати трубопровід
                            </button>
                        </div>
                        ${data}
                    `);
                    initPipeEvents();
                })
                .fail(function (xhr) {
                    $('#pipes').html(`
                        <div class="alert alert-danger">
                            Помилка завантаження трубопроводів: ${xhr.responseText || 'Невідома помилка'}
                        </div>
                        <button class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#addPipeModal">
                            <i class="bi bi-plus-circle"></i> Додати трубопровід
                        </button>
                    `);
                    console.error('Помилка:', xhr.statusText);
                });
        }


                // Функция для инициализации событий
            function initPipeEvents() {
        // Редактирование
        document.querySelectorAll('.btn-edit').forEach(btn => {
            btn.addEventListener('click', function() {
                const modal = new bootstrap.Modal(document.getElementById('addPipeModal'));
                document.getElementById('modalTitle').textContent = 'Редагувати трубопровід';
                document.getElementById('pipeId').value = this.dataset.id;
                document.getElementById('pipeName').value = this.dataset.name;
                document.getElementById('pipeSapId').value = this.dataset.sapId;
                document.getElementById('pipeExternalId').value = this.dataset.externalId;
                document.getElementById('gmoId').value = currentGmoId;
                modal.show();
            });
        });

                  // Загрузка данных при открытии вкладки
        document.addEventListener('DOMContentLoaded', function() {
            const pipesTab = document.getElementById('pipes-tab'); // ID вашей вкладки
            if (pipesTab) {
                pipesTab.addEventListener('click', loadPipes);
            }
        });

        // Загружаем список труб
                async function loadPipes(gmoId) {
            const tableBody = document.getElementById('pipesTableBody');
            tableBody.innerHTML = '<tr><td colspan="4" class="text-center"><div class="spinner-border"></div></td></tr>';

            try {
                const response = await fetch(`/MeasuringPipes/GetByGmo?gmoId=${gmoId}`);
                const pipes = await response.json();

                if (pipes.length === 0) {
                    tableBody.innerHTML = '<tr><td colspan="4" class="text-center">Немає даних</td></tr>';
                    return;
                }

                tableBody.innerHTML = pipes.map(pipe => `
                    <tr data-pipe-id="${pipe.id}">
                        <td>${pipe.nameMPipe}</td>
                        <td>${pipe.sapId || '-'}</td>
                        <td>${pipe.externalId || '-'}</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary btn-edit"
                                    data-id="${pipe.id}"
                                    data-name="${pipe.nameMPipe}"
                                    data-sap-id="${pipe.sapId}"
                                    data-external-id="${pipe.externalId}">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger btn-delete" data-id="${pipe.id}">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                `).join('');

                initPipeEvents(); // Инициализируем обработчики событий
            } catch (error) {
                tableBody.innerHTML = '<tr><td colspan="4" class="text-center text-danger">Помилка завантаження</td></tr>';
                console.error('Помилка:', error);
            }
        }   

        // Инициализация кнопок "Редагувати" и "Видалити"
        function initPipeEvents() {
            // Редактирование
            document.querySelectorAll('.btn-edit').forEach(btn => {
                btn.addEventListener('click', () => {
                    const modal = new bootstrap.Modal(document.getElementById('addPipeModal'));
                    document.getElementById('modalTitle').textContent = 'Редагувати трубопровід';
                    document.getElementById('pipeId').value = btn.dataset.id;
                    document.getElementById('pipeName').value = btn.dataset.name;
                    document.getElementById('pipeSapId').value = btn.dataset.sapId;
                    document.getElementById('pipeExternalId').value = btn.dataset.externalId;
                    modal.show();
                });
            });

            // Удаление
        document.querySelectorAll('.btn-delete').forEach(btn => {
            btn.addEventListener('click', async function() {
                if (!confirm('Видалити трубопровід?')) return;

                try {
                    const response = await fetch(`/MeasuringPipes/Delete?id=${this.dataset.id}`, {
                        method: 'DELETE'
                    });

                    if (response.ok) {
                        loadPipes(currentGmoId);
                    } else {
                        alert('Помилка видалення');
                    }
                } catch (error) {
                    console.error('Помилка:', error);
                }
            });
        });
        }

        // Сохранение данных
        document.getElementById('savePipeBtn').addEventListener('click', async () => {
            const pipeData = {
                Id: parseInt(document.getElementById('pipeId').value),
                NameMPipe: document.getElementById('pipeName').value,
                SapId: document.getElementById('pipeSapId').value,
                ExternalId: document.getElementById('pipeExternalId').value,
                IdGMO: parseInt(document.getElementById('gmoId').value)
            };

            try {
                const response = await fetch('/MeasuringPipes/CreateOrUpdate', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(pipeData)
                });

                if (response.ok) {
                    const modal = bootstrap.Modal.getInstance(document.getElementById('addPipeModal'));
                    modal.hide();
                    loadPipes(); // Обновляем таблицу
                } else {
                    alert('Помилка збереження');
                }
            } catch (error) {
                console.error('Помилка:', error);
            }
